# Force LF line endings for all shell/config files regardless of OS
*.sh        text eol=lf
*.env       text eol=lf
.env        text eol=lf
.env.prod   text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.go        text eol=lf
*.proto     text eol=lf
*.sql       text eol=lf
*.json      text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.md        text eol=lf
Makefile    text eol=lf
