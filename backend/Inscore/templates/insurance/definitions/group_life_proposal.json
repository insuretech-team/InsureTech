    { "type": "divider" },
    { "type": "heading", "text": "I.  CLIENT / GROUP DETAILS", "level": 1 },
    {
      "type": "key_value",
      "label_width": 3.0,
      "rows": [
        { "number": "1.", "label": "Company / Organization Name", "value": "{{ client_name }}" },
        { "number": "2.", "label": "Company Registration No.", "value": "{{ company_reg_number }}" },
        { "number": "3.", "label": "Industry / Sector", "value": "{{ industry_sector }}" },
        { "number": "4.", "label": "Contact Person & Designation", "value": "{{ contact_person }}" },
        { "number": "5.", "label": "Contact Phone & Email", "value": "{{ contact_phone_email }}" },
        { "number": "6.", "label": "Total Employees to be Covered", "value": "{{ total_employees }}" },
        { "number": "7.", "label": "Average Age of Workforce", "value": "{{ average_age }}" },
        { "number": "8.", "label": "Male / Female Split", "value": "{{ gender_split }}" }
      ]
    },
    { "type": "heading", "text": "II.  PROPOSED COVERAGE STRUCTURE", "level": 1 },
