# SSL Certificates (do not commit private keys)
ssl/certs/*.key
ssl/certs/*.pem
ssl/certs/*.crt
*.key
*.pem

# Cache directories - Keep config files, ignore runtime cache
!cache/
!cache/*.conf

# Runtime cache directories (generated at runtime)
proxy_temp/

# Log files
*.log
logs/

# Rendered output (generated from templates + .env.prod — never commit)
# Run: backend/infra/nginx/scripts/render-nginx-conf.ps1 (Windows)
#      backend/infra/nginx/scripts/render-nginx-conf.sh  (Linux/Mac)
dist/

# Temporary files
*.tmp
*.bak
*~

# OS files
.DS_Store
Thumbs.db
