<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.25.1" />
    <PackageReference Include="Grpc.Core.Api" Version="2.60.0" />
    <PackageReference Include="Grpc.Net.Client" Version="2.60.0" />
    <PackageReference Include="Google.Api.CommonProtos" Version="2.12.0" />
  </ItemGroup>

  <!-- Include all generated proto C# files from the central gen directory -->
  <ItemGroup>
    <Compile Include="..\..\..\..\gen\csharp\**\*.cs" LinkBase="Generated" />
  </ItemGroup>

  <!-- Suppress duplicate member warnings due to partial class merging across proto files -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);CS0102;CS0111</NoWarn>
  </PropertyGroup>

</Project>
